# 摄影器材租赁押金系统 —— Nginx 配置示例
# 要点：root 指向 public/，config/ 与 storage/ 在 docroot 之外，天然不可访问。

server {
    listen 80;
    server_name deposit.example.com;

    root /var/www/deposit/public;
    index index.html;

    client_max_body_size 1m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # 只执行 public/ 内真实存在的 .php
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    location ~ /\.(?!well-known) { deny all; }
    location ~* \.(sql|db|sqlite|sqlite-wal|sqlite-shm|log|ini|sh|key)$ { deny all; }

    # 建议：申请证书后加 HSTS
    # listen 443 ssl http2;
    # ssl_certificate     /etc/letsencrypt/live/deposit.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/deposit.example.com/privkey.pem;
    # add_header Strict-Transport-Security "max-age=31536000" always;
}
